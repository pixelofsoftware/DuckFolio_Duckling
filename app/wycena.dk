#{
    Raport portfela na wybrany dzień i historia wartości.

    Raport na dzień D obejmuje wszystkie operacje z datą nie późniejszą niż D (stan na koniec
    dnia). Instrumenty wyceniamy ceną z ceny.csv z dnia D. Brak ceny dla posiadanego
    instrumentu:
    * polityka ścisła (domyślna): raport jest odrzucony z listą brakujących cen,
    * polityka "wstecz": bierzemy najnowszą cenę sprzed dnia D i oznaczamy jej datę.
    Cena z późniejszego dnia nigdy nie zastępuje brakującej ceny. Instrument z zerową liczbą
    jednostek ma wartość 0 i nie potrzebuje ceny.

    Wynik kwotowy = wartość portfela - wpłaty zewnętrzne + wypłaty zewnętrzne.
    Udział składnika = wartość / wartość portfela, w setnych procenta, zaokrąglony połówkowo
    w górę; zaokrąglone udziały mogą nie sumować się do 100%. Przy wartości portfela 0 udziały
    są niedostępne ("n/d").
#}
import core.containers.*;
import app.tekst;
import app.dane;
import app.portfel;

class ZnalezionaCena {
    ok: bool = false;
    cena: i64 = 0;
    dzien: i64 = 0;
}

fun znajdzCene(ceny: ref List[dane.Cena], instrument: str, dzien: i64, wstecz: bool) -> ZnalezionaCena = {
    var wynik = ZnalezionaCena();
    var i: i64 = 0;
    while (i < ceny.length()) {
        if (tekst.rowne(ceny.at(i).instrument.asSlice(), instrument)) {
            let d = ceny.at(i).dzien;
            if (d == dzien or (wstecz and d < dzien and (not wynik.ok or d > wynik.dzien))) {
                if (not (wynik.ok and wynik.dzien == dzien)) {
                    wynik.ok = true;
                    wynik.cena = ceny.at(i).cena;
                    wynik.dzien = d;
                }
            }
        }
        i += 1;
    }
    return wynik;
}

#{
    Udział w setnych procenta: round(wartosc / razem * 10000), połówki w górę. Dzielenie
    pisemne na u64, więc nie ma przepełnienia dla wartości do ~1e18 groszy.
#}
fun udzial(wartosc: i64, razem: i64) -> i64 = {
    let t = razem as u64;
    var reszta = wartosc as u64;
    var iloraz: u64 = reszta / t;
    reszta = reszta % t;
    var k: i64 = 0;
    while (k < 4) {
        reszta = reszta * 10u64;
        iloraz = iloraz * 10u64 + reszta / t;
        reszta = reszta % t;
        k += 1;
    }
    if (reszta * 2u64 >= t) iloraz += 1u64;
    return iloraz as i64;
}

class Skladnik {
    instrument: String;
    liczba: i64 = 0;
    cena: i64 = 0;
    dzienCeny: i64 = 0;
    wycenaWstecz: bool = false;   # cena sprzed dnia raportu (polityka "wstecz")
    wartosc: i64 = 0;
    udzial: i64 = 0;
}

class Raport {
    ok: bool = false;
    bledy: List[String];
    dzien: i64 = 0;
    gotowka: i64 = 0;
    udzialGotowki: i64 = 0;
    skladniki: List[Skladnik];   # instrumenty alfabetycznie
    wartosc: i64 = 0;
    wplaty: i64 = 0;
    wyplaty: i64 = 0;
    prowizje: i64 = 0;
    wynik: i64 = 0;
    udzialyDostepne: bool = false;
}

# Indeksy pozycji posortowane alfabetycznie po nazwie instrumentu.
fun kolejnoscAlfabetyczna(p: ref portfel.Portfel) -> List[i64] = {
    var kolejnosc: List[i64];
    var i: i64 = 0;
    while (i < p.pozycje.length()) {
        kolejnosc.push(i);
        i += 1;
    }
    var a: i64 = 1;
    while (a < kolejnosc.length()) {
        var b = a;
        while (b > 0 and tekst.porownaj(p.pozycje.at(kolejnosc.at(b - 1)).instrument.asSlice(),
                                        p.pozycje.at(kolejnosc.at(b)).instrument.asSlice()) > 0) {
            let tmp = kolejnosc.at(b - 1);
            kolejnosc.at(b - 1) = kolejnosc.at(b);
            kolejnosc.at(b) = tmp;
            b -= 1;
        }
        a += 1;
    }
    return kolejnosc;
}

fun raport(operacje: ref List[dane.Operacja], ceny: ref List[dane.Cena], dzien: i64, wstecz: bool) -> Raport = {
    var wynik: Raport;
    wynik.dzien = dzien;
    var stan = portfel.odtworz(operacje, dzien);
    if (stan.bledy.length() > 0) {
        var i: i64 = 0;
        while (i < stan.bledy.length()) {
            wynik.bledy.push(copy stan.bledy.at(i));
            i += 1;
        }
        return wynik;
    }
    wynik.gotowka = stan.portfel.gotowka;
    wynik.wplaty = stan.portfel.wplaty;
    wynik.wyplaty = stan.portfel.wyplaty;
    wynik.prowizje = stan.portfel.prowizje;
    var razem = stan.portfel.gotowka;
    let kolejnosc = kolejnoscAlfabetyczna(&stan.portfel);
    var k: i64 = 0;
    while (k < kolejnosc.length()) {
        let poz = stan.portfel.pozycje.at(kolejnosc.at(k));
        var s: Skladnik;
        s.instrument.append(poz.instrument.asSlice());
        s.liczba = poz.liczba;
        if (poz.liczba > 0) {
            let c = znajdzCene(ceny, poz.instrument.asSlice(), dzien, wstecz);
            if (not c.ok) {
                let data = tekst.tekstDaty(dzien);
                if (wstecz) {
                    wynik.bledy.push(f"brak ceny {poz.instrument.asSlice()} z dnia {data.asSlice()} ani z dni wczesniejszych");
                } else {
                    wynik.bledy.push(f"brak ceny {poz.instrument.asSlice()} z dnia {data.asSlice()} (polityka scisla; polecenie 'wycena wstecz' pozwala uzyc wczesniejszej ceny)");
                }
            } else {
                s.cena = c.cena;
                s.dzienCeny = c.dzien;
                s.wycenaWstecz = c.dzien != dzien;
                s.wartosc = poz.liczba * c.cena;
                razem += s.wartosc;
            }
        }
        wynik.skladniki.push(move s);
        k += 1;
    }
    if (wynik.bledy.length() > 0) return wynik;
    wynik.wartosc = razem;
    wynik.wynik = razem - stan.portfel.wplaty + stan.portfel.wyplaty;
    wynik.udzialyDostepne = razem > 0;
    if (wynik.udzialyDostepne) {
        wynik.udzialGotowki = udzial(stan.portfel.gotowka, razem);
        var j: i64 = 0;
        while (j < wynik.skladniki.length()) {
            wynik.skladniki.at(j).udzial = udzial(wynik.skladniki.at(j).wartosc, razem);
            j += 1;
        }
    }
    wynik.ok = true;
    return wynik;
}

fun jednostkiInstrumentu(r: ref Raport, instrument: str) -> i64 = {
    var i: i64 = 0;
    while (i < r.skladniki.length()) {
        if (tekst.rowne(r.skladniki.at(i).instrument.asSlice(), instrument)) return r.skladniki.at(i).liczba;
        i += 1;
    }
    return 0;
}

fun wartoscInstrumentu(r: ref Raport, instrument: str) -> i64 = {
    var i: i64 = 0;
    while (i < r.skladniki.length()) {
        if (tekst.rowne(r.skladniki.at(i).instrument.asSlice(), instrument)) return r.skladniki.at(i).wartosc;
        i += 1;
    }
    return 0;
}

# Raport jako tabela tekstowa.
fun opisRaportu(r: ref Raport) -> String = {
    var w: String;
    let data = tekst.tekstDaty(r.dzien);
    w.append(f"Raport portfela na {data.asSlice()} (stan po wszystkich operacjach z tego dnia)\n");
    if (not r.ok) {
        w.append("RAPORT ODRZUCONY:\n");
        var i: i64 = 0;
        while (i < r.bledy.length()) {
            w.append(f"  - {r.bledy.at(i).asSlice()}\n");
            i += 1;
        }
        return w;
    }
    w.append(tekst.kolumna("Skladnik", 12, false).asSlice());
    w.append(tekst.kolumna("Jednostki", 11, true).asSlice());
    w.append(tekst.kolumna("Cena", 13, true).asSlice());
    w.append(tekst.kolumna("Wartosc", 16, true).asSlice());
    w.append(tekst.kolumna("Udzial", 10, true).asSlice());
    w.append("\n");
    w.append(tekst.kolumna("GOTOWKA", 12, false).asSlice());
    w.append(tekst.kolumna("-", 11, true).asSlice());
    w.append(tekst.kolumna("-", 13, true).asSlice());
    w.append(tekst.kolumna(tekst.kwotaTekst(r.gotowka).asSlice(), 16, true).asSlice());
    if (r.udzialyDostepne) w.append(tekst.kolumna(tekst.udzialTekst(r.udzialGotowki).asSlice(), 10, true).asSlice());
    else w.append(tekst.kolumna("n/d", 10, true).asSlice());
    w.append("\n");
    var suma = r.udzialGotowki;
    var wstecz = false;
    var j: i64 = 0;
    while (j < r.skladniki.length()) {
        let s = r.skladniki.at(j);
        w.append(tekst.kolumna(s.instrument.asSlice(), 12, false).asSlice());
        w.append(tekst.kolumna(s.liczba.toString().asSlice(), 11, true).asSlice());
        if (s.liczba > 0) {
            var cena = tekst.kwotaTekst(s.cena);
            if (s.wycenaWstecz) {
                cena.append('*');
                wstecz = true;
            }
            w.append(tekst.kolumna(cena.asSlice(), 13, true).asSlice());
        } else {
            w.append(tekst.kolumna("-", 13, true).asSlice());
        }
        w.append(tekst.kolumna(tekst.kwotaTekst(s.wartosc).asSlice(), 16, true).asSlice());
        if (r.udzialyDostepne) w.append(tekst.kolumna(tekst.udzialTekst(s.udzial).asSlice(), 10, true).asSlice());
        else w.append(tekst.kolumna("n/d", 10, true).asSlice());
        w.append("\n");
        suma += s.udzial;
        j += 1;
    }
    w.append(tekst.kolumna("RAZEM", 36, false).asSlice());
    w.append(tekst.kolumna(tekst.kwotaTekst(r.wartosc).asSlice(), 16, true).asSlice());
    if (r.udzialyDostepne) w.append(tekst.kolumna("100.00%", 10, true).asSlice());
    else w.append(tekst.kolumna("n/d", 10, true).asSlice());
    w.append("\n");
    if (r.udzialyDostepne and suma != 10000) {
        w.append(f"(udzialy zaokraglone do 0.01%; ich suma to {tekst.udzialTekst(suma).asSlice()})\n");
    }
    if (not r.udzialyDostepne) w.append("(wartosc portfela 0 - udzialy niedostepne)\n");
    if (wstecz) {
        var k: i64 = 0;
        while (k < r.skladniki.length()) {
            if (r.skladniki.at(k).wycenaWstecz) {
                let dzienCeny = tekst.tekstDaty(r.skladniki.at(k).dzienCeny);
                w.append(f"* {r.skladniki.at(k).instrument.asSlice()}: brak ceny z dnia raportu, uzyto ceny z {dzienCeny.asSlice()}\n");
            }
            k += 1;
        }
    }
    let wplaty = tekst.kwotaTekst(r.wplaty);
    let wyplaty = tekst.kwotaTekst(r.wyplaty);
    let wynikTekst = tekst.kwotaTekst(r.wynik);
    w.append(f"Wplaty zewnetrzne: {wplaty.asSlice()}   Wyplaty zewnetrzne: {wyplaty.asSlice()}\n");
    w.append(f"Wynik kwotowy: {wynikTekst.asSlice()}  (wartosc - wplaty + wyplaty; nie jest stopa zwrotu)\n");
    return w;
}

# Dni historii: daty operacji i cen nie późniejsze niż doDnia, od pierwszej operacji, rosnąco.
fun dniHistorii(operacje: ref List[dane.Operacja], ceny: ref List[dane.Cena], doDnia: i64) -> List[i64] = {
    var dni: List[i64];
    if (operacje.length() == 0) return dni;
    let pierwszy = operacje.at(0).dzien;
    var kandydaci: List[i64];
    var i: i64 = 0;
    while (i < operacje.length()) { kandydaci.push(operacje.at(i).dzien); i += 1; }
    var j: i64 = 0;
    while (j < ceny.length()) { kandydaci.push(ceny.at(j).dzien); j += 1; }
    var k: i64 = 0;
    while (k < kandydaci.length()) {
        let d = kandydaci.at(k);
        if (d >= pierwszy and d <= doDnia) {
            # Wstawienie z pominięciem powtórzeń, z zachowaniem kolejności rosnącej.
            var nowe: List[i64];
            var wstawiony = false;
            var m: i64 = 0;
            while (m < dni.length()) {
                if (dni.at(m) == d) wstawiony = true;
                if (not wstawiony and dni.at(m) > d) {
                    nowe.push(d);
                    wstawiony = true;
                }
                nowe.push(dni.at(m));
                m += 1;
            }
            if (not wstawiony) nowe.push(d);
            dni = move nowe;
        }
        k += 1;
    }
    return dni;
}

# Historia wartości jako tabela; dzień bez potrzebnej ceny jest oznaczony, a nie pomijany.
fun opisHistorii(operacje: ref List[dane.Operacja], ceny: ref List[dane.Cena], doDnia: i64, wstecz: bool) -> String = {
    var w: String;
    let doTekst = tekst.tekstDaty(doDnia);
    w.append(f"Historia wartosci portfela do {doTekst.asSlice()}\n");
    w.append(tekst.kolumna("Data", 12, false).asSlice());
    w.append(tekst.kolumna("Gotowka", 14, true).asSlice());
    w.append(tekst.kolumna("Instrumenty", 14, true).asSlice());
    w.append(tekst.kolumna("Wartosc", 14, true).asSlice());
    w.append(tekst.kolumna("Wplaty", 14, true).asSlice());
    w.append(tekst.kolumna("Wyplaty", 12, true).asSlice());
    w.append(tekst.kolumna("Wynik", 12, true).asSlice());
    w.append("\n");
    let dni = dniHistorii(operacje, ceny, doDnia);
    if (dni.length() == 0) w.append("(brak operacji do tego dnia)\n");
    var i: i64 = 0;
    while (i < dni.length()) {
        let r = raport(operacje, ceny, dni.at(i), wstecz);
        let data = tekst.tekstDaty(dni.at(i));
        w.append(tekst.kolumna(data.asSlice(), 12, false).asSlice());
        if (r.ok) {
            w.append(tekst.kolumna(tekst.kwotaTekst(r.gotowka).asSlice(), 14, true).asSlice());
            w.append(tekst.kolumna(tekst.kwotaTekst(r.wartosc - r.gotowka).asSlice(), 14, true).asSlice());
            w.append(tekst.kolumna(tekst.kwotaTekst(r.wartosc).asSlice(), 14, true).asSlice());
            w.append(tekst.kolumna(tekst.kwotaTekst(r.wplaty).asSlice(), 14, true).asSlice());
            w.append(tekst.kolumna(tekst.kwotaTekst(r.wyplaty).asSlice(), 12, true).asSlice());
            w.append(tekst.kolumna(tekst.kwotaTekst(r.wynik).asSlice(), 12, true).asSlice());
        } else {
            w.append(f"  brak wyceny: {r.bledy.at(0).asSlice()}");
        }
        w.append("\n");
        i += 1;
    }
    return w;
}
